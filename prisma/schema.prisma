generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  telegramId  String   @unique @map("telegram_id")
  name        String
  username    String?
  role        String   @default("client") // client | provider | admin
  language    String   @default("ru") // ru | en — выбор экрана language, привязан к telegramId
  entryRole   String?  @map("entry_role") // client | provider | null — ещё не выбран; экран role показывать, пока null
  rating      Float    @default(0) // рейтинг клиента — считается по ClientReview (отзывы от мастеров)
  reviewCount Int      @default(0) @map("review_count")
  active      Boolean  @default(true) // «мягкое удаление» аккаунта клиентом — профиль и рейтинг сохраняются, см. usersService.deactivate
  blocked     Boolean  @default(false) // блокировка админом за нарушения — не путать с active (самоудаление); блокирует только НОВЫЕ действия (заявки), история остаётся видна
  notifyOrders  Boolean @default(true) @map("notify_orders") // уведомление в Telegram: мастер откликнулся на заявку
  notifyReviews Boolean @default(true) @map("notify_reviews") // уведомление в Telegram: мастер оставил отзыв о клиенте
  notifyChat    Boolean @default(true) @map("notify_chat") // уведомление в Telegram: новое сообщение в чате заказа
  createdAt   DateTime @default(now()) @map("created_at")

  provider      Provider?
  requests      Request[]
  reviews       Review[] // отзывы, которые этот клиент оставил мастерам
  clientReviews ClientReview[] // отзывы, которые мастера оставили об этом клиенте

  @@map("users")
}

model Provider {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description     String?
  priceFrom       Int?     @map("price_from")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  responseTimeMin Int      @default(30) @map("response_time_min")
  verified        Boolean  @default(false)
  blocked         Boolean  @default(false) // модерация админом — не путать с active (самостоятельное отключение мастером)
  active          Boolean  @default(true) // «мягкое удаление» профиля мастером, см. providersService.deactivate
  tier            String   @default("free") // free | pro — см. subscriptionsService.getEffectiveTier, тариф напрямую не читать
  tierUntil       DateTime? @map("tier_until") // до какой даты активен pro; null/прошлое — эффективно free
  balance         Int      @default(0) // баланс в целых лари, не может уходить в минус
  notifyRequests  Boolean  @default(true) @map("notify_requests") // уведомление в Telegram: новая заявка под услуги мастера
  notifyReviews   Boolean  @default(true) @map("notify_reviews") // уведомление в Telegram: клиент оставил отзыв о мастере
  notifyOrders    Boolean  @default(true) @map("notify_orders") // уведомление в Telegram: клиент принял отклик мастера
  notifyChat      Boolean  @default(true) @map("notify_chat") // уведомление в Telegram: новое сообщение в чате заказа
  createdAt       DateTime @default(now()) @map("created_at")

  services      ProviderService[]
  areas         ProviderArea[]
  offers        Offer[]
  reviews       Review[] // отзывы клиентов об этом мастере
  clientReviews ClientReview[] // отзывы, которые этот мастер оставил клиентам
  leadCharges   LeadCharge[]
  transactions  Transaction[]

  @@map("providers")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  icon     String?
  services Service[]

  @@map("categories")
}

model Service {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])
  name       String

  providers ProviderService[]
  requests  Request[]

  @@map("services")
}

model ProviderService {
  providerId Int      @map("provider_id")
  serviceId  Int      @map("service_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id])

  @@id([providerId, serviceId])
  @@map("provider_services")
}

model ProviderArea {
  providerId Int      @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  area       String

  @@id([providerId, area])
  @@map("provider_areas")
}

model Request {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId   Int      @map("service_id")
  service     Service  @relation(fields: [serviceId], references: [id])
  description String?
  budget      Int?
  urgency     String?
  area        String?
  status      String   @default("open") // open | matched | completed | cancelled
  archived    Boolean  @default(false) // клиент удалил заявку до выбора мастера — уходит в архив, не в БД-удаление
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  offers        Offer[]
  reviews       Review[]
  clientReviews ClientReview[]
  charges       LeadCharge[]
  messages      Message[]

  @@map("requests")
}

model Offer {
  id         Int      @id @default(autoincrement())
  requestId  Int      @map("request_id")
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId Int      @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  price      Int
  comment    String?
  status     String   @default("pending") // pending | accepted | declined
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("offers")
}

// Чат по заказу — доступен только после того, как клиент принял отклик
// (см. Offer.status == "accepted"); участник со стороны мастера
// определяется через этот принятый отклик, а не хранится тут отдельно —
// см. messagesService.getThreadContext. senderRole вместо userId/providerId,
// т.к. это просто «кто из двух сторон», а не ссылка на отдельную сущность.
model Message {
  id         Int       @id @default(autoincrement())
  requestId  Int       @map("request_id")
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderRole String    @map("sender_role") // client | provider
  text       String
  readAt     DateTime? @map("read_at") // прочитано получателем (не отправителем) — источник счётчика непрочитанных
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("messages")
}

model Review {
  id         Int      @id @default(autoincrement())
  requestId  Int      @map("request_id")
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId Int      @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  tags       String[] @default([])
  text       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

// Зеркало Review в обратную сторону: отзыв мастера о клиенте после
// завершения заказа (Request.status === "completed"), см. reviewsService.
model ClientReview {
  id         Int      @id @default(autoincrement())
  requestId  Int      @map("request_id")
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId Int      @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId     Int      @map("user_id") // клиент, которого оценивают
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  tags       String[] @default([])
  text       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("client_reviews")
}

// Списание за отклик на конкретную заявку — ровно одно на пару (мастер, заявка),
// см. subscriptionsService.chargeLead. providerId/requestId — SetNull, не Cascade:
// это финансовая/аналитическая история, обязана пережить настоящее удаление
// мастера или заявки через админку (DELETE /api/admin/providers|requests/:id),
// а не блокировать его и не исчезать вместе с ним.
model LeadCharge {
  id         Int       @id @default(autoincrement())
  providerId Int?      @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  requestId  Int?      @map("request_id")
  request    Request?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  amount     Int // сколько списали, в целых лари (0 — пока цены нулевые)
  tier       String // тариф на момент списания, для аналитики
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([providerId, requestId])
  @@map("lead_charges")
}

// Журнал движения денег мастера — единственный источник истины по балансу,
// см. раздел «Известные грабли» про рейтинги: та же логика, любое изменение
// баланса обязано сопровождаться записью сюда. providerId — SetNull, не
// Cascade: журнал обязан пережить настоящее удаление Provider через админку.
model Transaction {
  id         Int       @id @default(autoincrement())
  providerId Int?      @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  type       String // topup | subscription | lead | refund
  amount     Int // со знаком: плюс приход, минус расход, в целых лари
  externalId String?   @map("external_id") // id платежа во внешней системе, на будущее
  comment    String? // для ручных операций админа
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("transactions")
}

// Обращение в поддержку из личного кабинета клиента/мастера («Написать в
// поддержку» — форма, не чат). Записывается в базу и параллельно
// пересылается администратору в Telegram ботом, см.
// src/modules/support/service.ts и notifyAdmin в src/bot/bot.ts. Без
// relation на User/Provider — денормализованные telegramId/name/username,
// как в Transaction/LeadCharge: это запись обращения, а не бизнес-сущность.
model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  tag         String? // короткая категория, напр. «Проф. химия оптом»
  logoEmoji   String?  @map("logo_emoji")
  logoImage   String?  @map("logo_image") // data: URI (base64), приоритетнее logoEmoji если задан; ограничение на размер — в роутере
  description String? // текст на странице карточки партнёра
  offerText   String?  @map("offer_text") // акция/промокод
  website     String?
  telegram    String?
  area        String?
  active      Boolean  @default(true) // видимость клиентам; управляется вручную из админки
  sortOrder   Int      @default(0) @map("sort_order")
  // Показ баннера клиенту (главная лента/страница списка) — считается на
  // фронтенде через POST /partners/impressions. Клик — открытие карточки
  // партнёра («Узнать больше»), через POST /partners/:id/click. Переход по
  // внешней ссылке (сайт/telegram) намеренно не считаем — для этого партнёру
  // выдаётся ссылка с UTM-меткой, сравнение делается на его стороне.
  impressionCount Int @default(0) @map("impression_count")
  clickCount      Int @default(0) @map("click_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("partners")
}

model SupportTicket {
  id         Int      @id @default(autoincrement())
  telegramId String   @map("telegram_id")
  name       String
  username   String?
  role       String // client | provider — из какого кабинета написали
  subject    String?
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("support_tickets")
}

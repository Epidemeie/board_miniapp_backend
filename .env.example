# Строка подключения к PostgreSQL (в Coolify скопируется из карточки БД)
DATABASE_URL="postgresql://user:password@localhost:5432/tbilisi_services?schema=public"

# Порт, на котором слушает backend
PORT=3000

# Логин/пароль для входа в /admin (Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Токен бота из BotFather — нужен для проверки подлинности Telegram-пользователей
# и для запуска самого бота уведомлений (см. src/bot/bot.ts). Без него бот просто
# не стартует (WARN в логах), остальной backend продолжает работать.
TELEGRAM_BOT_TOKEN=your-bot-token

# Домен фронтенда — разрешённый источник для CORS
CORS_ORIGIN=https://goservices.lol

# Адрес Mini App — на неё ведёт кнопка в сообщениях бота
MINI_APP_URL=https://goservices.lol

# Numeric chat ID админа, которому бот шлёт уведомления в личку (сейчас —
# новые обращения в поддержку, см. src/bot/bot.ts notifyAdmin). Telegram Bot
# API не умеет писать по @username — только по числовому id. Чтобы узнать
# свой: написать что угодно боту @userinfobot, он ответит числом. Без этой
# переменной обращения по-прежнему сохраняются в БД, просто не долетают
# уведомлением (см. WARN в логах).
SUPPORT_ADMIN_CHAT_ID=
